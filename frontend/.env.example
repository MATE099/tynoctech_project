# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so your secrets never get committed.

# --- AWS credentials ---
# For real AWS: use an IAM user's access key.
# For DynamoDB Local (docker compose): any non-empty dummy value works.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# --- Admin login (HTTP Basic auth for /admin and /api/admin) ---
# Required in production: without them the admin area answers 503.
# In development, leaving them empty keeps the admin open for convenience.
# Use a long random password, e.g. run: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_long_random_password

# --- DynamoDB table names ---
PRODUCTS_TABLE_NAME=Products
CATEGORIES_TABLE_NAME=Categories
CARTS_TABLE_NAME=Carts
WISHLISTS_TABLE_NAME=Wishlists
USERS_TABLE_NAME=Users

# --- Optional: local DynamoDB endpoint ---
# Leave empty to use real AWS. docker-compose sets this automatically to
# http://dynamodb-local:8000 for the containerized app.
# DYNAMODB_ENDPOINT=http://localhost:8000
